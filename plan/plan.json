  },
  "sentences": [
   {
    "text": "Three rings. Always three.",
    "beat": "walk",
    "setting": "pathway",
    "delivery": "hushed",
    "speaker": "narrator",
    "frame": false,
    "voice": ""
   },
   {
    "text": "The old tales say a sickness touched the workers, turning men to crawling dust at midnight.",
    "beat": "omen",
    "setting": "village",
    "delivery": "low",
    "speaker": "narrator",
    "frame": false,
    "voice": ""
   },
   {
    "text": "I was there that night.",
    "beat": "home",
    "setting": "village",
    "delivery": "trembling",
    "speaker": "narrator",
    "frame": true,
    "voice": ""
   },
   {
    "text": "It pours beneath the heavy oak and gathers tall with glowing eyes.",
    "beat": "door",
    "setting": "village",
    "delivery": "dread",
    "speaker": "narrator",
    "frame": false,
    "voice": ""
   },
   {
    "text": "A sweet nursery tune drifted through the frost, drawing it closer.",
    "beat": "window",
    "setting": "village",
    "delivery": "sorrow",
    "speaker": "narrator",
    "frame": false,
    "voice": ""
   },
   {
    "text": "Wait, WHAT?!",
    "beat": "window",
    "setting": "village",
    "delivery": "urgent",
    "speaker": "host",
    "voice": "host",
    "frame": false
   },
   {
    "text": "When the singing stopped, it lunged in silence.",
    "beat": "attack",
    "setting": "village",
    "delivery": "shout",
    "speaker": "narrator",
    "frame": false,
    "voice": ""
   },
   {
    "text": "Only a dropped lantern remained in the dark.",
    "beat": "aftermath",
    "setting": "village",
    "delivery": "calm",
    "speaker": "narrator",
    "frame": false,
    "voice": ""
   },
   {
    "text": "Would you sing to keep the swarm away?",
    "beat": "stalk",
    "setting": "village",
    "delivery": "sorrow",
    "speaker": "narrator",
    "frame": false,
    "voice": ""
   }
  ],
